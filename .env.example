# Public application URL
APP_URL=http://localhost:3000
NODE_ENV=development

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot OAuth app settings
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/oauth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write

# Wix app credentials (server-side only)
WIX_APP_ID=
WIX_APP_SECRET=
WIX_WEBHOOK_SECRET=

# 32-byte key, encoded as 64 hexadecimal characters or base64.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Protects the internal webhook worker endpoint (server-side only).
CRON_SECRET=
