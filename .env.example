# Application
APP_BASE_URL=http://localhost:3000
DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_API_KEY=
CRON_SECRET=
# Generate with: openssl rand -hex 32 (or openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Supabase server-only credentials
SUPABASE_URL=
# Preferred server key; keep service-role fallback only for existing projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Customer access remains disabled until tenant onboarding and acceptance pass.
CUSTOMER_ACCESS_ENABLED=false
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HubSpot developer app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/oauth/hubspot/callback
# Separate customer callback; defaults to APP_BASE_URL + this path when omitted.
HUBSPOT_CUSTOMER_REDIRECT_URI=http://localhost:3000/api/customer/oauth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read crm.schemas.contacts.write

# Wix app credentials; instance ID identifies the installed Wix app/site
WIX_APP_ID=
WIX_APP_SECRET=
WIX_INSTANCE_ID=
WIX_WEBHOOK_PUBLIC_KEY=
